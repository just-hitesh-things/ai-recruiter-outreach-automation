# ------------------------
# PostgreSQL configuration
# ------------------------
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=changeme_local_dev_only
POSTGRES_DB=n8n

# ------------------------
# n8n <-> Postgres connection
# ------------------------
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=changeme_local_dev_only

# ------------------------
# n8n core settings
# ------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Required so n8n can encrypt/decrypt stored credentials.
# Generate a real one later with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace_with_generated_key

# Timezone (adjust if needed)
GENERIC_TIMEZONE=Asia/Kolkata